# Theme: carbonfox
# Colors lifted straight from kitty/dark-theme.auto.conf (nightfox.nvim's
# carbonfox palette: https://github.com/EdenEast/nightfox.nvim) so btop
# matches the rest of this setup instead of drifting to its own palette.

# Main bg
theme[main_bg]="#161616"

# Main text color
theme[main_fg]="#f2f4f8"

# Title color for boxes
theme[title]="#f2f4f8"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#78a9ff"

# Background color of selected item in processes box
theme[selected_bg]="#2a2a2a"

# Foreground color of selected item in processes box
theme[selected_fg]="#f2f4f8"

# Color of inactive/disabled text
theme[inactive_fg]="#484848"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#78a9ff"

# Cpu box outline color
theme[cpu_box]="#535353"

# Memory/disks box outline color
theme[mem_box]="#535353"

# Net up/down box outline color
theme[net_box]="#535353"

# Processes box outline color
theme[proc_box]="#535353"

# Box divider line and small boxes line color
theme[div_line]="#535353"

# Temperature graph colors
theme[temp_start]="#25be6a"
theme[temp_mid]="#ebcb8b"
theme[temp_end]="#ee5396"

# CPU graph colors
theme[cpu_start]="#25be6a"
theme[cpu_mid]="#ebcb8b"
theme[cpu_end]="#ee5396"

# Mem/Disk free meter
theme[free_start]="#25be6a"
theme[free_mid]="#ebcb8b"
theme[free_end]="#ee5396"

# Mem/Disk cached meter
theme[cached_start]="#25be6a"
theme[cached_mid]="#ebcb8b"
theme[cached_end]="#ee5396"

# Mem/Disk available meter
theme[available_start]="#25be6a"
theme[available_mid]="#ebcb8b"
theme[available_end]="#ee5396"

# Mem/Disk used meter
theme[used_start]="#25be6a"
theme[used_mid]="#ebcb8b"
theme[used_end]="#ee5396"

# Download graph colors
theme[download_start]="#25be6a"
theme[download_mid]="#ebcb8b"
theme[download_end]="#ee5396"

# Upload graph colors
theme[upload_start]="#25be6a"
theme[upload_mid]="#ebcb8b"
theme[upload_end]="#ee5396"
