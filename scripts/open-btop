#!/bin/bash
# Reuses the existing btop kitty window if one is already running
# instead of spawning a duplicate every time the shortcut is pressed.
# Matched by its own command line rather than a WM query, so this
# doesn't depend on which window manager (if any) is currently active.

if ! pgrep -f 'kitty --title kitty.btop' >/dev/null; then
    exec kitty --title kitty.btop -e btop
fi
