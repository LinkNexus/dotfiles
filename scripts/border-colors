#!/bin/bash
# Prints the JankyBorders color arguments for the current OS theme.
# Single source of truth -- used by start-borders at login and by
# on-theme-change when the appearance flips.
# THEME_OVERRIDE=light|dark exists for previewing the other variant.

THEME=light
[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" = "Dark" ] && THEME=dark
[ -n "$THEME_OVERRIDE" ] && THEME="$THEME_OVERRIDE"

# Active color is the same purple accent carbonfox/dayfox use for
# "claude" elsewhere (claude/themes/*.json) so the focused-window
# highlight reads as this setup's signature color instead of a
# low-contrast near-black/near-white line; inactive reuses those same
# themes' "inactive" shade.
if [ "$THEME" = "dark" ]; then
  echo "active_color=0xffbe95ff inactive_color=0xff5a5a5c"
else
  echo "active_color=0xff6e33ce inactive_color=0xff837a72"
fi
