#!/bin/bash
# Runs every time macOS switches between light and dark mode --
# invoked by scripts/theme-watcher, which runs as a LaunchAgent
# (launchd/com.levynkeneng.theme-watcher.plist) independent of
# AeroSpace/sketchybar. Add anything here that needs to react to a
# theme change.

# Recolor the sketchybar workspace pills (skipped when sketchybar is
# down, e.g. with AeroSpace disabled away from the external monitor)
if pgrep -xq sketchybar; then
  sketchybar --trigger aerospace_workspace_change
fi

# Reload tmux config on the running server, same as prefix + r --
# tmux_theme.conf re-detects the theme and sources the right palette
if tmux has-session 2>/dev/null; then
  tmux source-file ~/.config/tmux/tmux.conf
  tmux display-message "Theme changed, tmux reloaded"
fi

# Recolor JankyBorders window borders (live update; the pgrep guard
# matters -- with no daemon running, borders would BECOME the daemon
# and this script would block forever)
if pgrep -xq borders; then
  borders $("$(dirname "$0")/border-colors")
fi

# Switch Claude Code between the custom carbonfox/dayfox themes
# (claude/themes in this repo, symlinked to ~/.claude/themes).
# Running sessions hot-reload settings.json, so this applies live.
if [ "${THEME_OVERRIDE:-$(defaults read -g AppleInterfaceStyle 2>/dev/null)}" = "Dark" ] || [ "${THEME_OVERRIDE:-}" = "dark" ]; then
  CLAUDE_THEME="custom:carbonfox"
else
  CLAUDE_THEME="custom:dayfox"
fi
python3 - "$CLAUDE_THEME" <<'EOF'
import json, os, sys
path = os.path.expanduser("~/.claude/settings.json")
try:
    with open(path) as f:
        settings = json.load(f)
except (FileNotFoundError, ValueError):
    settings = {}
settings["theme"] = sys.argv[1]
with open(path, "w") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
EOF
