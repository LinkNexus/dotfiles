#!/bin/bash
# Runs on every display configuration change, and once at login --
# invoked by scripts/display-watcher (LaunchAgent, independent of any
# window manager). Decides whether sketchybar/borders are worth having
# from the WIDTH of the biggest connected screen instead of hardcoding a
# specific monitor: below the threshold they're stopped (menu bar height
# and the notch eat too much of the built-in screen for them to be
# useful); at or above it they're started.
#
# Paneru (the tiling WM, see paneru/paneru.toml) is NOT toggled here --
# unlike AeroSpace before it, it's designed to stay useful on any screen
# size and runs continuously as its own launchd service (`paneru
# install`). Stage Manager is disabled unconditionally below for the same
# reason: it fights with tiling, and tiling is now always active.
#
# Reference widths in points: built-in 14" = 1512, 16" = 1728; most
# 27" externals >= 1920; the LG ultrawide = 2924. MIN_WIDTH is also
# overridable from the environment for testing.
MIN_WIDTH="${MIN_WIDTH:-1800}"

LOG=/tmp/display-watcher.log
log() { echo "$(date '+%F %T') $*" >> "$LOG"; }

WIDEST=$(osascript -l JavaScript -e '
ObjC.import("AppKit");
let max = 0;
const screens = $.NSScreen.screens;
for (let i = 0; i < screens.count; i++) {
  const w = screens.objectAtIndex(i).frame.size.width;
  if (w > max) max = w;
}
Math.round(max)' 2>/dev/null)

# If we could not measure (early login, window server not ready...),
# DO NOTHING -- wrongly disabling is worse than staying stale
if ! [ "$WIDEST" -ge 0 ] 2>/dev/null; then
  log "screen measurement failed (got '$WIDEST'); leaving state untouched"
  exit 0
fi

# killall Dock is how a GloballyEnabled change actually takes effect --
# skip it when the value is already right so we don't restart the Dock
# (and flash the screen) on every display event for nothing.
stage_manager_off() {
  local current
  current=$(defaults read com.apple.WindowManager GloballyEnabled 2>/dev/null)
  if [ "$current" != "0" ]; then
    defaults write com.apple.WindowManager GloballyEnabled -bool false
    killall Dock 2>/dev/null
  fi
}
stage_manager_off

if [ "$WIDEST" -ge "$MIN_WIDTH" ]; then
  log "widest screen ${WIDEST}pt >= ${MIN_WIDTH}: sketchybar on, borders on"
  if ! pgrep -xq sketchybar; then
    nohup sketchybar >/dev/null 2>&1 &
  fi
  if ! pgrep -xq borders; then
    nohup "$(dirname "$0")/start-borders" >/dev/null 2>&1 &
  fi
  # Feeds sketchybar/plugins/paneru.sh; pointless without a bar to update
  if ! pgrep -f 'paneru subscribe --json' >/dev/null; then
    nohup "$(dirname "$0")/paneru-subscribe" >/dev/null 2>&1 &
  fi
else
  log "widest screen ${WIDEST}pt < ${MIN_WIDTH}: sketchybar off, borders off"
  pkill -x sketchybar 2>/dev/null
  pkill -x borders 2>/dev/null
  pkill -f 'paneru subscribe --json' 2>/dev/null
fi
