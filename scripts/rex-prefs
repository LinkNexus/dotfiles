#!/usr/bin/env python3
# Versions Rex's Settings-window preferences, which live in the app's
# defaults domain rather than in a config file (init.lua only holds keys).
#
#   rex-prefs export   copy the current settings into the repo
#   rex-prefs apply    write the repo's settings back (Rex must be quit)
#
# Only Workspace.* keys are kept, minus the ones that are session state
# rather than settings. customThemes is a JSON blob, so it is stored
# pretty-printed in themes.json to keep diffs readable; the theme IDs
# inside it are what darkThemeID/lightThemeID point at.

import json
import os
import plistlib
import subprocess
import sys

DOMAIN = "com.superlogical.rex"
ROOT = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "rex")
SETTINGS = os.path.join(ROOT, "settings.plist")
THEMES = os.path.join(ROOT, "themes.json")
THEMES_KEY = "Workspace.customThemes"
STATE_KEYS = {
    "Workspace.lastFocusedSession",
    "Workspace.programActivitySeen",
    "Workspace.openWindows",
    "Workspace.sessionOrder",
    "Workspace.mutedTabs",
    "Workspace.hasDismissedRaisedTextContrastNotice",
}


def read_domain():
    out = subprocess.run(["defaults", "export", DOMAIN, "-"],
                         capture_output=True, check=True).stdout
    return plistlib.loads(out)


def export():
    prefs = read_domain()
    settings = {k: v for k, v in prefs.items()
                if k.startswith("Workspace.")
                and k not in STATE_KEYS and k != THEMES_KEY}
    with open(SETTINGS, "wb") as f:
        plistlib.dump(settings, f, sort_keys=True)
    if THEMES_KEY in prefs:
        with open(THEMES, "w") as f:
            json.dump(json.loads(prefs[THEMES_KEY]), f, indent=2, sort_keys=True)
            f.write("\n")
    print(f"exported {len(settings)} settings to {os.path.relpath(ROOT)}")


def apply():
    # A running Rex rewrites its preferences and would undo this
    if subprocess.run(["pgrep", "-x", "Rex"], capture_output=True).returncode == 0:
        sys.exit("rex-prefs: quit Rex first")
    prefs = read_domain() if subprocess.run(
        ["defaults", "read", DOMAIN], capture_output=True).returncode == 0 else {}
    with open(SETTINGS, "rb") as f:
        prefs.update(plistlib.load(f))
    if os.path.exists(THEMES):
        with open(THEMES) as f:
            prefs[THEMES_KEY] = json.dumps(json.load(f), separators=(",", ":")).encode()
    subprocess.run(["defaults", "import", DOMAIN, "-"],
                   input=plistlib.dumps(prefs, fmt=plistlib.FMT_BINARY), check=True)
    print("applied Rex settings")


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "export":
        export()
    elif cmd == "apply":
        apply()
    else:
        sys.exit("usage: rex-prefs export|apply")
