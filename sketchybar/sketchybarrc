#!/usr/bin/env lua
-- ~/.config/sketchybar/sketchybarrc
--
-- Rewritten onto SbarLua (github.com/FelixKratz/SbarLua) instead of the
-- classic bash + `sketchybar --add/--set` CLI style (see git history for
-- that version) -- native Lua item state instead of re-querying/
-- re-parsing the bar's contents on every workspace-pill rebuild.
--
-- SbarLua itself is built from source by scripts/install-sbarlua (run by
-- `make install`) into ~/.local/share/sketchybar_lua/sketchybar.so;
-- `lua` (5.5, matching the vendored version the .so is built against --
-- confirmed ABI-compatible) comes from the Brewfile.
package.cpath = package.cpath .. ';' .. os.getenv('HOME') .. '/.local/share/sketchybar_lua/?.so'
sbar = require('sketchybar')

-- Bundle the entire initial configuration into a single message to
-- sketchybar -- see bar.lua / default.lua / items/scrollspace.lua
sbar.begin_config()
require('bar')
require('default')
require('items.scrollspace')
sbar.hotload(true)
sbar.end_config()

-- Without this, no callback (subscribe/exec) ever fires
sbar.event_loop()
