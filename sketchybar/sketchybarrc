#!/bin/bash
# ~/.config/sketchybar/sketchybarrc
#
# Same non-destructive approach as before: fully transparent bar
# overlaying the real native menu bar. The workspace items themselves
# are created/destroyed dynamically by plugins/paneru.sh, not defined
# statically here -- this file just sets up the bar and wires the
# trigger.

CONFIG_DIR="$HOME/.config/sketchybar"

# 30 = native menu bar height on this display (NSScreen frame minus
# visibleFrame) -- must match or items sit higher than menu bar content
sketchybar --bar height=30 \
                  color=0x00000000 \
                  border_width=0 \
                  shadow=off \
                  sticky=off \
                  topmost=window \
                  blur_radius=0 \
                  y_offset=0

sketchybar --default icon.drawing=off \
                      label.drawing=off \
                      background.drawing=off

# Register the custom event that scripts/paneru-subscribe triggers on
# workspace/window changes -- REQUIRED before anything can --subscribe to it
sketchybar --add event paneru_workspace_change

# A hidden control item -- its only job is to own the event
# subscription and run the rebuild script whenever workspaces change.
# update_freq is a safety-net poll in case an event is ever missed/
# coalesced away, not the primary update path.
sketchybar --add item paneru_control center \
           --subscribe paneru_control paneru_workspace_change \
           --set paneru_control \
                 drawing=off \
                 script="$CONFIG_DIR/plugins/paneru.sh" \
                 update_freq=30

# NOTE: the theme-change watcher is NOT started here anymore -- it
# runs as its own LaunchAgent (launchd/com.levynkeneng.theme-watcher.plist,
# installed by `make install`) so it survives sketchybar being
# disabled; on-theme-change also serves tmux and JankyBorders.

# Draw the initial state immediately, don't wait for the first switch
sketchybar --trigger paneru_workspace_change
