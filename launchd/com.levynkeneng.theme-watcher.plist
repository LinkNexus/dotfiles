<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.levynkeneng.theme-watcher</string>

	<!-- launchd does not expand $HOME in ProgramArguments, hence the
	     absolute path. Installed by `make install` (copied, not
	     symlinked -- launchd is unreliable with symlinked plists). -->
	<key>ProgramArguments</key>
	<array>
		<string>/Users/levynkeneng/dotfiles/scripts/start-theme-watcher</string>
	</array>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>

	<!-- launchd's default PATH has neither nix nor homebrew; the
	     on-theme-change hook needs both (tmux / sketchybar, borders) -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/run/current-system/sw/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>StandardErrorPath</key>
	<string>/tmp/theme-watcher.err</string>
</dict>
</plist>
