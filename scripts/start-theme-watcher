#!/bin/bash
# Entry point for the theme-watcher LaunchAgent (launchd/*.plist).
# The watcher runs independently of sketchybar on purpose: on-theme-change
# also serves tmux and JankyBorders, which are still wanted even when
# sketchybar itself is stopped (e.g. on the built-in screen only).

DIR="$(cd "$(dirname "$0")" && pwd)"

# The compiled binary is gitignored; build it on first run
if [ ! -x "$DIR/theme-watcher" ]; then
  swiftc -O -o "$DIR/theme-watcher" "$DIR/theme-watcher.swift" || exit 1
fi

exec "$DIR/theme-watcher" "$DIR/on-theme-change"
