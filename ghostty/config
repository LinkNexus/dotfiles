# Mirrors kitty/kitty.conf + kitty/macos.conf
# Shell comes from the login shell (/bin/zsh), matching kitty's `shell /bin/zsh`.

# Font ------------------------------------------------------------------------
font-family = MonaspiceRn Nerd Font Mono
font-feature = calt
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
font-feature = ss09
font-feature = ss10
font-feature = liga

# font-family = CaskaydiaCove Nerd Font Mono
# font-feature = calt
# font-feature = ss01
# font-feature = ss02
# font-feature = ss03
# font-feature = ss19
# font-feature = ss20
font-size = 19

adjust-cell-width = -5%
adjust-underline-position = 2
adjust-underline-thickness = 150%

# Theme -----------------------------------------------------------------------
# kitty auto-switches via dark-theme.auto.conf / light-theme.auto.conf
theme = dark:Carbonfox,light:Dayfox

# Window ----------------------------------------------------------------------
background-opacity = 0.65
background-blur = 25
window-padding-x = 10
window-padding-y = 10

# Cursor ----------------------------------------------------------------------
custom-shader = shaders/cursor_trail.glsl

# macOS -----------------------------------------------------------------------
macos-auto-secure-input = false
